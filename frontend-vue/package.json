{
  "name": "frontend-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "eslint . --fix && stylelint \"**/*.{vue,scss,css}\" --fix --allow-empty-input && prettier \"**/*.{css,scss,vue,ts,js,json,yaml,yml}\" --write --ignore-path .prettierignore -u",
    "format:check": "eslint . && stylelint \"**/*.{vue,scss,css}\" --allow-empty-input && prettier \"**/*.{css,scss,vue,ts,js,json,yaml,yml}\" --check --ignore-path .prettierignore -u",
    "format:branch": "f() { FILES=$(git diff --name-only --diff-filter=ACMR $(git merge-base HEAD main) | grep '^frontend-vue/' | sed 's|^frontend-vue/||'); VUE_TS_JS=$(echo \"$FILES\" | grep -E '\\.(vue|ts|js)$'); STYLE_FILES=$(echo \"$FILES\" | grep -E '\\.(css|scss|vue)$'); if [ -n \"$VUE_TS_JS\" ]; then eslint $VUE_TS_JS --fix; fi; if [ -n \"$STYLE_FILES\" ]; then stylelint $STYLE_FILES --fix --allow-empty-input; fi; if [ -n \"$FILES\" ]; then prettier $FILES --write; fi; }; f",
    "format:branch:check": "f() { FILES=$(git diff --name-only --diff-filter=ACMR $(git merge-base HEAD main) | grep '^frontend-vue/' | sed 's|^frontend-vue/||'); VUE_TS_JS=$(echo \"$FILES\" | grep -E '\\.(vue|ts|js)$'); STYLE_FILES=$(echo \"$FILES\" | grep -E '\\.(css|scss|vue)$'); if [ -n \"$VUE_TS_JS\" ]; then eslint $VUE_TS_JS; fi && if [ -n \"$STYLE_FILES\" ]; then stylelint $STYLE_FILES --allow-empty-input; fi && if [ -n \"$FILES\" ]; then prettier $FILES --check; fi; }; f",
    "lint": "eslint . --fix",
    "lint:report": "eslint . --format html --output-file eslint-report.html",
    "lint:style": "stylelint \"**/*.{vue,css,scss}\" --fix --allow-empty-input",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist node_modules/.vite",
    "build:analyze": "vite build --mode analyze",
    "gen-client": "openapi-ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@mdi/font": "^7.4.47",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "chartjs-chart-treemap": "^3.1.0",
    "dayjs": "^1.11.19",
    "devicon": "^2.17.0",
    "file-icons-js": "github:websemantics/file-icons-js",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "vuetify": "^3.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@hey-api/openapi-ts": "^0.90.3",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.7",
    "@types/uuid": "^10.0.0",
    "@types/web": "^0.0.260",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/devtools": "^8.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.1.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "eslint-plugin-yaml": "^1.1.3",
    "globals": "^17.6.0",
    "jiti": "^2.4.2",
    "lint-staged": "^16.2.4",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "sass": "^1.89.2",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.1.9",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.10"
  },
  "lint-staged": {
    "*.vue": [
      "vue-tsc --noEmit",
      "eslint --fix --cache --cache-location node_modules/.cache/.eslintcache",
      "stylelint --fix --cache --cache-location node_modules/.cache/.stylelintcache",
      "prettier --write"
    ],
    "*.{js,ts}": [
      "eslint --fix --cache --cache-location node_modules/.cache/.eslintcache",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --cache --cache-location node_modules/.cache/.stylelintcache",
      "prettier --write"
    ],
    "*.{json,jsonc,json5,md,yaml,yml,html}": [
      "prettier --write"
    ]
  }
}
